# Configuration Supabase — copiez ce fichier en .env.local et renseignez vos clés :
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# (ou NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...)

# URL publique du site (utilisée pour les métadonnées OpenGraph et la confirmation e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
